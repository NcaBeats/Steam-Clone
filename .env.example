# Plantilla de variables del frontend. Copiar a .env y ajustar.
# En produccion NO se usa .env: Vercel inyecta estas variables desde el
# panel (Settings > Environment Variables) y hay que redeployar cuando cambia
# cualquier NEXT_PUBLIC_*.
#
# NEXT_PUBLIC_API_BASE_URL -> base del backend. Unica: se evalua en build time
#                             y la usan tanto el servidor (Server Actions) como
#                             el navegador (search.ts, media.ts).
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL -> base publica de Cloudflare R2, usada por
#                             lib/media.ts para resolver /uploads/games/... .

# --- Desarrollo local ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9090/api/v1
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-58f3bb038ab8451e96fb292f7cb1dc15.r2.dev
