# Plantilla de variables del frontend. Copiar a .env y ajustar.
# En produccion NO se usa .env: Vercel inyecta estas variables desde el
# panel (Settings > Environment Variables) y hay que redeployar cuando cambia
# cualquiera.
#
# API_BASE_URL -> base del backend para el servidor (Server Actions, SSR)
#                 y destino del rewrite /api/v1/* (next.config.ts).
#                 El navegador no usa variables: llama siempre a la ruta
#                 relativa /api/v1 (mismo origen, sin CORS).
#
# --- Desarrollo local ---
API_BASE_URL=http://127.0.0.1:9090/api/v1
